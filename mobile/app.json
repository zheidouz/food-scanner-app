{
  "expo": {
    "name": "Food Scanner",
    "slug": "food-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E8F5E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodscanner.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan food barcodes and labels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9"
      },
      "package": "com.foodscanner.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "We need camera access to scan food barcodes and labels."
        }
      ]
    ]
  }
}
